{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClosedPort",
  "version": "0.3.0",
  "identifier": "com.closedport.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ClosedPort", "width": 1180, "height": 760, "minWidth": 900, "minHeight": 600, "resizable": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
